# SQLite is the no-setup default for local Windows use.
DATABASE_URL=sqlite:///./ecommerce_ops.db
MONITOR_INTERVAL_SECONDS=60
SAFETY_BUFFER_DAYS=2
LOW_STOCK_DAYS=7
DEAD_STOCK_DAYS=30

# Optional LLM (leave blank for fully functional rules-based demo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Shopify read-only integration; do not commit real values
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-10
